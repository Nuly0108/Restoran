<Window x:Class="WpfApp1.ZakazWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Морской вкус  — Заказы" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D2A4A" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0">
            <Grid>
                <TextBlock x:Name="RolText" Text="Роль сотрудника" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="Выйти" Click="Logout_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Padding="14,6" FontSize="13" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="МЕНЮ" Click="GoMenu_Click" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
                <Button Content="БРОНИРОВАНИЕ" Click="GoBron_Click" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
                <Button Content="ЗАКАЗЫ" Click="GoZakaz_Click" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="Transparent" Padding="20,10,20,10">
            <Button Content="+ Новый заказ" Click="NewOrder_Click" Width="200" Height="42" FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
        </Border>

        <Grid x:Name="OrderForm" Grid.Row="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Margin="20,0,10,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#123C6B" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Стол" Foreground="White" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TableBox" Height="30" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Гостей" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox x:Name="GuestsBox" Height="30" FontSize="14" VerticalContentAlignment="Center" Text="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Категория" Foreground="White" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CatBox" Height="30" FontSize="14" SelectionChanged="CatBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BlyudaList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Height="250" Background="#FFE0B2" BorderBrush="#E0A96D" BorderThickness="2" CornerRadius="6" Margin="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="White" CornerRadius="4,4,0,0" Margin="4">
                                            <Grid>
                                                <TextBlock Text="фото" Foreground="#BDBDBD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Foto}" Stretch="Uniform" Margin="4"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#4E342E" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                        <TextBlock Grid.Row="2" Text="{Binding PriceText}" FontSize="13" Foreground="#BF360C" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <Button Grid.Row="3" Content="+" Width="50" Height="34" Margin="0,4,0,8" HorizontalAlignment="Center" Background="Transparent" Foreground="#1565C0" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" Click="AddToOrder_Click" Tag="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="#0D47A1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ПРАВАЯ ЧАСТЬ -->
            <Border Grid.Column="1" Margin="10,0,20,20" Background="#123C6B" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Текущий заказ" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CurrentItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D2A4A" CornerRadius="6" Padding="10,6" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="13" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="×" Width="22" Height="22" Background="Transparent" Foreground="#FF8A80" BorderThickness="0" FontSize="14" Cursor="Hand" Tag="{Binding}" Click="RemoveItem_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" x:Name="TotalText" Text="Итого: 0 ₽" FontSize="16" FontWeight="Bold" Foreground="#FFE082" Margin="0,10,0,10"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сохранить" Click="CreateOrder_Click" Width="120" Height="36" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="Отмена" Click="CancelOrder_Click" Width="100" Height="36" Background="#BBDEFB" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="OrderError" Grid.Row="3" Foreground="#FF8A80" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </Grid>

        <!-- СПИСОК ЗАКАЗОВ -->
        <ScrollViewer x:Name="ZakazyList" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="ZakazyGrid">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#123C6B" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="8" Padding="20,14" Margin="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Info}" FontSize="15" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Оплатить" Click="PayOrder_Click" Tag="{Binding Id}" Width="110" Height="34" Margin="0,0,8,0" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand" FontSize="13">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1565C0" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1976D2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="X" Click="DeleteOrder_Click" Tag="{Binding Id}" Width="34" Height="34" Foreground="#B08968" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="#5D4037"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ФОРМА ОПЛАТЫ -->
        <Grid x:Name="PayForm" Grid.Row="0" Grid.RowSpan="4" Background="#CC0D2A4A" Visibility="Collapsed">
            <Border Background="#123C6B" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="14" Padding="30" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Оплата заказа" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Сумма к оплате:" Foreground="#BBDEFB" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PaySumText" Text="0 ₽" FontSize="24" FontWeight="Bold" Foreground="#FFE082" Margin="0,0,0,16"/>
                    <TextBlock Text="Чаевые (необязательно):" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="PayTips" Height="32" FontSize="14" Margin="0,0,0,16" VerticalContentAlignment="Center" Text="0"/>
                    <TextBlock Text="Способ оплаты:" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PayMethod" Height="32" FontSize="14" Margin="0,0,0,20">
                        <ComboBoxItem Content="Наличные" IsSelected="True"/>
                        <ComboBoxItem Content="Карта"/>
                        <ComboBoxItem Content="QR-код"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Оплатить" Click="ConfirmPay_Click" Width="130" Height="38" Margin="0,0,10,0" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="Отмена" Click="CancelPay_Click" Width="100" Height="38" Background="#BBDEFB" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="PayError" Foreground="#FF8A80" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>