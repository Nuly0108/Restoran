<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Морской вкус "
        Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D2A4A">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" >

            <Border Background="#1565C0" CornerRadius="12" Padding="20,18" Margin="0,0,0,30">
               <StackPanel>
                    <TextBlock Text="Морской вкус " FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            
            <TextBlock Text="Логин" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
            <Border Background="White" BorderBrush="#BBDEFB" BorderThickness="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                <TextBox Name="LoginBox" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                         Height="28"/>
            </Border>

           
            <TextBlock Text="Пароль" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
            <Border Background="White"
                    BorderBrush="#BBDEFB"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,24">
                <PasswordBox Name="ParolBox"
                             FontSize="15"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Height="28"/>
            </Border>

            
            <Border Background="White"
                    BorderBrush="#BBDEFB"
                    BorderThickness="2"
                    CornerRadius="8">
                <Button Name="B1"
                        Content="Войти"
                        Height="42"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0D2A4A"
                        Cursor="Hand"
                        Click="B1_Click"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Border>

            
            <TextBlock Name="ErrorText"
                       Foreground="#FF8A80"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</Window>