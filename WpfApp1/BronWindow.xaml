<Window x:Class="WpfApp1.BronWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Морской вкус  — Бронирование"
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D2A4A" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid>
                <TextBlock x:Name="RolText" Text="Роль сотрудника" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="Выйти" Click="Logout_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Padding="14,6" FontSize="13" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ВКЛАДКИ -->
        <Border Grid.Row="1" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="МЕНЮ" Click="Button_Click" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
                <Button Content="БРОНИРОВАНИЕ" Click="Button_Click_1" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#1565C0" BorderThickness="0" Cursor="Hand"/>
                <Button Content="ЗАКАЗЫ" Click="Button_Click_2" Margin="4,0" Padding="24,12" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#0D47A1" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Календарь -->
            <Border Grid.Row="0" Background="Transparent" Padding="20,10,20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Дата брони:" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="BronDate" Width="200" Height="32" FontSize="14" SelectedDateChanged="BronDate_Changed"/>
                </StackPanel>
            </Border>

            <!-- Список броней на день -->
            <Border Grid.Row="1" Background="#123C6B" CornerRadius="10" Padding="16" Margin="20,0,20,10">
                <StackPanel>
                    <TextBlock Text="Брони на выбранный день" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BronList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D2A4A" CornerRadius="6" Padding="10,6" Margin="0,3"
                                            Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonDown="BronRow_Click">
                                        <TextBlock Text="{Binding Info}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="BronEmptyText" Text="На эту дату броней нет"
                               Foreground="#8D6E63" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Форма брони -->
            <Border x:Name="BronForm" Grid.Row="2" Background="#123C6B" CornerRadius="10" Padding="20"
                    Margin="20,0,20,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок формы -->
                    <TextBlock x:Name="FormTitle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Новая бронь" Foreground="#BBDEFB" FontSize="14"
                               FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Имя гостя" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="BronName" Height="30" FontSize="14" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,10">
                        <TextBlock Text="Телефон" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="BronPhone" Height="30" FontSize="14" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,10">
                        <TextBlock Text="Время (ЧЧ:ММ)" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="BronTime" Height="30" FontSize="14" VerticalContentAlignment="Center" Text="19:00"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="B1" Content="Забронировать" Click="B1_Click"
                                Width="150" Height="36" Foreground="White"
                                Background="#1565C0" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDeleteBron" Content="Удалить бронь" Click="DeleteBron_Click"
                                Width="150" Height="36" Foreground="White"
                                Background="#B71C1C" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="B2" Content="Отмена" Click="B2_Click"
                                Width="100" Height="36" Background="#BBDEFB"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock x:Name="BronError" Grid.Row="2" Grid.Column="0"
                               Foreground="#FF8A80" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Сетка столов -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl x:Name="StolyGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="140" Height="100" Background="{Binding Color}" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="8" Margin="10" Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonDown="Stol_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="#0D2A4A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Info}" FontSize="12" Foreground="#37474F" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="6,4,6,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>